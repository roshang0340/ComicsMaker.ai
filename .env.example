# ComicCraft — Gemini configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional comma-separated rotation pool:
# GEMINI_API_KEYS=KEY_1,KEY_2

# Current Gemini text generation models
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite

# Native Gemini image generation (Nano Banana family)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_PREMIUM_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image

PORT=8080
MAX_PANELS=8
MAX_UPLOAD_MB=10
